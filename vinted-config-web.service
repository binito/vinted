[Unit]
Description=Vinted configuration viewer for local network
After=network.target

[Service]
Type=simple
User=jorge
WorkingDirectory=/home/jorge/vinted
ExecStart=/home/jorge/vinted/venv/bin/python3 -u /home/jorge/vinted/vinted_config_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
